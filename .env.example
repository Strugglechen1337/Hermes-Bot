# Lokale Konfiguration für Hermes Pocket (NICHT in Git committen!)
# Kopiere diese Datei nach ".env" und trage deine echten Werte lokal ein.

# Basis-URL der bestehenden Hermes-Weboberfläche / des Gateways
# - Auf dem Hermes-Server selbst: http://127.0.0.1:9130
# - Über Tailscale von einem anderen Gerät: https://<dein-hermes-host>.ts.net:<port>
HERMES_BASE_URL=http://127.0.0.1:9130

# Port & Bind-Adresse für den Hermes Pocket BFF-Server (Standard: 127.0.0.1:9135)
# Hinweis: Port 9130 gehört dem bestehenden Hermes-Webserver und bleibt unangetastet.
HOST=127.0.0.1
PORT=9135

# Optional: auf "true" setzen, wenn Hermes Pocket hinter einem HTTPS-Proxy (z. B. Tailscale Serve) läuft,
# damit Session-Cookies immer mit "Secure" gesetzt werden. Bei automatischer Erkennung reicht "auto".
COOKIE_SECURE=auto
