def wrap_page(title: str, body: str, subtitle: str = "", eyebrow: str = "", bot: str = "") -> str:
    now = dt.datetime.now()
    byline_parts = [german_date(now), now.strftime("%H:%M Uhr")]
    if bot:
        byline_parts.append(f"erstellt von {bot}")
    return TEMPLATE.format(
        title=esc(title),
        eyebrow=esc(eyebrow or "Hermes Pocket"),
        subtitle_html=f'<p class="subtitle">{md_inline(subtitle)}</p>' if subtitle else "",
        byline=esc(" · ".join(byline_parts)),
        body=body,
    )


def read_input(path: str) -> str:
    if path == "-":
        data = sys.stdin.read()
    else:
        data = Path(path).read_text(encoding="utf-8")
    if len(data.encode("utf-8")) > MAX_BYTES:
        sys.exit("Fehler: Seite ist größer als 3 MB.")
    return data


def notify(title: str, body: str, bot: str) -> None:
    token_path = DATA_DIR / "bot-push-token"
    if not token_path.is_file():
        print("Hinweis: Push noch nicht eingerichtet – Seite wurde trotzdem veröffentlicht.", file=sys.stderr)
        return
    payload = json.dumps({"title": title, "body": body, "bot": bot}).encode("utf-8")
    req = urllib.request.Request(
        os.environ.get("POCKET_NOTIFY_URL", "http://127.0.0.1:9135/api/pocket/push/notify"),
        data=payload,
        headers={"Content-Type": "application/json", "X-Pocket-Push-Token": token_path.read_text().strip()},
        method="POST",
    )
    try:
        urllib.request.urlopen(req, timeout=15).read()
    except Exception as exc:  # noqa: BLE001
        print(f"Hinweis: Push konnte nicht gesendet werden ({exc}).", file=sys.stderr)


def prune() -> None:
    pages = sorted(PAGES_DIR.glob("*.html"), key=lambda p: p.stat().st_mtime, reverse=True)
    for old in pages[KEEP_PAGES:]:
        for p in (old, old.with_suffix(".json")):
            try:
                p.unlink()
            except OSError:
                pass


def clean_field(text: str, limit: int) -> str:
    return re.sub(r"[\[\]|\r\n]+", " ", text).strip()[:limit]


def main() -> None:
    ap = argparse.ArgumentParser(description="Seite in Hermes Pocket veröffentlichen")
    ap.add_argument("--title", required=True)
    ap.add_argument("--summary", default="")
    ap.add_argument("--bot", default="")
    ap.add_argument("--subtitle", default="")
    ap.add_argument("--eyebrow", default="", help="Kleine Überschrift, z. B. 'Tagesbriefing'")
    src = ap.add_mutually_exclusive_group(required=True)
    src.add_argument("--json")
    src.add_argument("--markdown")
    src.add_argument("--html")
    ap.add_argument("--notify", action="store_true", help="Zusätzlich Push-Benachrichtigung senden")
    args = ap.parse_args()

    title = clean_field(args.title, 120) or "Seite"
    summary = clean_field(args.summary, 220)

    if args.json:
        try:
            data = json.loads(read_input(args.json))
        except json.JSONDecodeError as exc:
            sys.exit(f"Fehler: Ungültiges JSON ({exc}).")
        if not isinstance(data, dict):
            sys.exit("Fehler: JSON muss ein Objekt sein.")
        page = wrap_page(
            data.get("title") or title,
            render_briefing(data),
            subtitle=data.get("subtitle") or args.subtitle,
            eyebrow=data.get("eyebrow") or args.eyebrow,
            bot=args.bot,
        )
        if not summary:
            summary = clean_field(str(data.get("intro") or data.get("summary") or ""), 220)
    elif args.markdown:
        page = wrap_page(title, markdown_to_html(read_input(args.markdown)),
                         subtitle=args.subtitle, eyebrow=args.eyebrow, bot=args.bot)
    else:
        raw = read_input(args.html)
        if re.search(r"<html[\s>]", raw, re.I):
            page = raw
        else:
            page = wrap_page(title, raw, subtitle=args.subtitle, eyebrow=args.eyebrow, bot=args.bot)

    PAGES_DIR.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(PAGES_DIR, 0o700)
    except OSError:
        pass

    page_id = f"{slugify(title)}-{dt.datetime.now():%Y%m%d}-{secrets.token_hex(3)}"
    html_path = PAGES_DIR / f"{page_id}.html"
    meta_path = PAGES_DIR / f"{page_id}.json"
    html_path.write_text(page, encoding="utf-8")
    meta_path.write_text(json.dumps({
        "id": page_id,
        "title": title,
        "summary": summary,
        "bot": clean_field(args.bot, 64),
        "createdAt": int(dt.datetime.now().timestamp() * 1000),
    }, ensure_ascii=False), encoding="utf-8")
    for p in (html_path, meta_path):
        try:
            os.chmod(p, 0o600)
        except OSError:
            pass
    prune()

    if args.notify:
        notify(title, summary or "Neue Seite ist fertig.", args.bot)

    print(f"[POCKET_PAGE: {page_id} | {title} | {summary}]")


if __name__ == "__main__":
    main()
