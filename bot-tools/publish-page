#!/usr/bin/env python3
"""
Hermes Pocket · publish-page

Veröffentlicht eine von einem Bot erstellte Seite (z. B. Tagesbriefing, Bericht,
Übersicht) lokal in Hermes Pocket und gibt die Chat-Zeile aus, die der Bot ans
Ende seiner Antwort setzt:

    [POCKET_PAGE: <id> | <Titel> | <Kurzbeschreibung>]

Eingabeformate (genau eins):
  --json FILE       Strukturiertes Briefing (empfohlen, wird automatisch schön gestaltet)
  --markdown FILE   Markdown-Text (wird in das Hermes-Pocket-Layout gesetzt)
  --html FILE       Eigenes HTML (vollständiges Dokument oder Fragment)
  FILE = "-" liest von stdin.

Sicherheit: Seiten werden nur angemeldeten Hermes-Sitzungen ausgeliefert und in
einer Sandbox (eigener, opaker Ursprung) angezeigt. Niemals Passwörter, Tokens
oder andere Geheimnisse in Seiten schreiben.
"""
import argparse
import datetime as dt
import html
import json
import os
import re
import secrets
import sys
import urllib.request
from pathlib import Path

MAX_BYTES = 3 * 1024 * 1024
KEEP_PAGES = 200

SCRIPT_DIR = Path(__file__).resolve().parent
DATA_DIR = Path(os.environ.get("PUSH_DATA_DIR") or (SCRIPT_DIR.parent / ".data"))
PAGES_DIR = DATA_DIR / "pages"

WEEKDAYS = ["Montag", "Dienstag", "Mittwoch", "Donnerstag", "Freitag", "Samstag", "Sonntag"]
MONTHS = ["Januar", "Februar", "März", "April", "Mai", "Juni", "Juli", "August",
          "September", "Oktober", "November", "Dezember"]


def german_date(d: dt.datetime) -> str:
    return f"{WEEKDAYS[d.weekday()]}, {d.day}. {MONTHS[d.month - 1]} {d.year}"


def esc(value) -> str:
    return html.escape(str(value or ""), quote=True)


def safe_url(value) -> str:
    url = str(value or "").strip()
    return url if re.match(r"^https?://", url, re.I) else ""


def slugify(text: str) -> str:
    t = text.lower()
    for a, b in (("ä", "ae"), ("ö", "oe"), ("ü", "ue"), ("ß", "ss")):
        t = t.replace(a, b)
    t = re.sub(r"[^a-z0-9]+", "-", t).strip("-")
    return (t[:40].strip("-")) or "seite"


def host_of(url: str) -> str:
    m = re.match(r"^https?://(?:www\.)?([^/:?#]+)", url, re.I)
    return m.group(1) if m else ""


# ── Minimal, safe Markdown → HTML ────────────────────────────────────────────

def md_inline(text: str) -> str:
    out = esc(text)
    out = re.sub(
        r"!\[([^\]]*)\]\((https?://[^\s)]+)\)",
        lambda m: f'<img class="inline-img" src="{m.group(2)}" alt="{m.group(1)}" loading="lazy" referrerpolicy="no-referrer">',
        out,
    )
    out = re.sub(
        r"\[([^\]]+)\]\((https?://[^\s)]+)\)",
        lambda m: f'<a href="{m.group(2)}" target="_blank" rel="noopener noreferrer">{m.group(1)}</a>',
        out,
    )
    out = re.sub(r"\*\*([^*]+)\*\*", r"<strong>\1</strong>", out)
    out = re.sub(r"(?<!\*)\*([^*]+)\*(?!\*)", r"<em>\1</em>", out)
    out = re.sub(r"`([^`]+)`", r"<code>\1</code>", out)
    return out


def markdown_to_html(md: str) -> str:
    lines = md.replace("\r\n", "\n").split("\n")
    parts, para, items = [], [], []

    def flush_para():
        if para:
            parts.append("<p>" + "<br>".join(md_inline(l) for l in para) + "</p>")
            para.clear()

    def flush_list():
        if items:
            parts.append("<ul>" + "".join(f"<li>{md_inline(i)}</li>" for i in items) + "</ul>")
            items.clear()

    for line in lines:
        h = re.match(r"^(#{1,4})\s+(.*)$", line)
        b = re.match(r"^\s*[-*•]\s+(.*)$", line)
        if h:
            flush_para(); flush_list()
            level = min(4, len(h.group(1)) + 1)
            parts.append(f"<h{level}>{md_inline(h.group(2))}</h{level}>")
        elif b:
            flush_para(); items.append(b.group(1))
        elif not line.strip():
            flush_para(); flush_list()
        else:
            flush_list(); para.append(line)
    flush_para(); flush_list()
    return '<section class="card prose">' + "\n".join(parts) + "</section>"


# ── Structured briefing JSON → HTML ──────────────────────────────────────────

def render_item(item) -> str:
    if isinstance(item, str):
        return f'<article class="item"><p>{md_inline(item)}</p></article>'
    title = item.get("title", "")
    text = item.get("text") or item.get("summary") or ""
    url = safe_url(item.get("url"))
    image = safe_url(item.get("image"))
    source = item.get("source") or (host_of(url) if url else "")
    tag = item.get("tag", "")
    img_html = (
        f'<img class="item-img" src="{esc(image)}" alt="{esc(title)}" loading="lazy" referrerpolicy="no-referrer">'
        if image else ""
    )
    title_html = (
        f'<a href="{esc(url)}" target="_blank" rel="noopener noreferrer">{esc(title)}</a>' if url and title else esc(title)
    )
    meta = []
    if tag:
        meta.append(f'<span class="chip">{esc(tag)}</span>')
    if source:
        meta.append(f'<span class="source">{esc(source)}</span>')
    return (
        '<article class="item">'
        f"{img_html}"
        '<div class="item-body">'
        + (f'<h3>{title_html}</h3>' if title else "")
        + (f"<p>{md_inline(text)}</p>" if text else "")
        + (f'<div class="meta">{"".join(meta)}</div>' if meta else "")
        + "</div></article>"
    )


def render_briefing(data: dict) -> str:
    out = []
    intro = data.get("intro") or data.get("summary")
    if intro:
        out.append(f'<section class="card intro"><p>{md_inline(intro)}</p></section>')

    highlights = data.get("highlights") or []
    if highlights:
        out.append(
            '<section class="card highlights"><h2>Auf einen Blick</h2><ul>'
            + "".join(f"<li>{md_inline(h)}</li>" for h in highlights)
            + "</ul></section>"
        )

    sections = data.get("sections") or []
    if len(sections) > 1:
        out.append(
            '<nav class="tabs" aria-label="Rubriken">'
            + "".join(
                f'<a class="tab" href="#s{i}">{esc((s.get("icon") or "") + " " + (s.get("title") or "")).strip()}</a>'
                for i, s in enumerate(sections)
            )
            + "</nav>"
        )
    for i, s in enumerate(sections):
        items = s.get("items") or []
        heading = esc(((s.get("icon") or "") + " " + (s.get("title") or "")).strip())
        out.append(
            f'<section class="section" id="s{i}"><h2>{heading}</h2>'
            + (f'<p class="section-intro">{md_inline(s.get("intro"))}</p>' if s.get("intro") else "")
            + '<div class="items">' + "".join(render_item(it) for it in items) + "</div></section>"
        )

    footer = data.get("footer")
    if footer:
        out.append(f'<p class="footnote">{md_inline(footer)}</p>')
    return "\n".join(out)


